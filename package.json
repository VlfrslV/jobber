{
  "name": "@jobber/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start:auth": "nx serve auth",
    "build:auth": "nx build auth",
    "generate:auth": "nx run auth:generate-types",
    "migrate:auth": "nx run auth:migrate-prisma",
    "start:jobs": "nx serve jobs",
    "build:jobs": "nx build jobs",
    "start:executor": "nx serve executor",
    "start:all": "nx run-many -t serve --projects=auth,jobs,executor",
    "build:all": "nx run-many -t build",
    "start:dist:auth": "node ./dist/apps/auth/main.js",
    "start:dist:jobs": "node ./dist/apps/jobs/main.js",
    "start:dist:executor": "node ./dist/apps/executor/main.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "lint:all": "nx run-many -t lint",
    "test:all": "nx run-many -t test",
    "graph": "nx graph",
    "prepare": "husky",
    "g:nest": "bash tools/generate-nest-feature.sh"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.0",
