    "@swc/helpers": "~0.5.18",
    "@types/express": "^4.17.21",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "lint-staged": "^16.4.0",
    "nx": "23.1.2",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.7",
