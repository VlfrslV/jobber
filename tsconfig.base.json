{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@jobber/nestjs": ["./libs/nestjs/src/index.ts"],
      "@jobber/types": ["./libs/types/src/index.ts"],
      "@jobber/types/*": ["./libs/types/src/*"],
      "@prisma-clients/jobber-auth": [
        "./node_modules/@prisma-clients/jobber-auth"
      ],
      "@jobber/pulsar": ["./pulsar/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
