{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@jobber/graphql": ["./libs/graphql/src/index.ts"],
      "@jobber/nestjs": ["./libs/nestjs/src/index.ts"],
      "@prisma-clients/auth": ["./node_modules/@prisma-clients/auth"],
      "@jobber/pulsar": ["./libs/pulsar/src/index.ts"],
      "@jobber/grpc": ["./libs/grpc/src/index.ts"],
      "@jobber/prisma": ["./libs/prisma/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
